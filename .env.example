# Dire Dawa University - AI-Based Smart Academic Assistant
# Root Environment Template (Phases 1, 2, 3)

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/ddu_academic_assistant
JWT_SECRET=ddu_super_secret_jwt_key_2026_academic_assistant_cs_iot
JWT_EXPIRES_IN=7d

# AI Gateway Service (Phase 2)
AI_PROVIDER=gemini # 'gemini' or 'openai' (or any OpenAI-compatible API)
AI_API_KEY=your_api_key_here
AI_MODEL=gemini-1.5-flash
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=15000
AI_CACHE_TTL_MS=86400000

# Email & Notifications (Phase 3)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=academic.assistant@ddu.edu.et
SMTP_PASS=your_email_app_password
EMAIL_FROM="Dire Dawa University Academic Portal" <no-reply@ddu.edu.et>
MAIL_FROM="Dire Dawa University Academic Portal" <no-reply@ddu.edu.et>

# File Upload Settings (Phase 3)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=15

# Client Configuration
VITE_API_URL=http://localhost:5000/api
